  };
  r.onend=()=>{
    if(r!==rec)return;
    if(on&&always){setTimeout(()=>{if(r!==rec||!on)return;try{r.start()}catch(x){stopRec();$('heard').textContent='Ascolto interrotto: tocca il microfono per riattivarlo.'}},250)}
