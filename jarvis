const hud=$('hud'),cv=$('cv'),cx=cv.getContext('2d');
let hudOn=false,pts=[],raf=0,ang=0,env=0,hudTimer=0;
function hudInit(){pts=[];for(let i=0;i<90;i++){const u=Math.random()*2-1,a=Math.random()*6.283,r=Math.sqrt(1-u*u);pts.push({x:r*Math.cos(a),y:u,z:r*Math.sin(a),p:Math.random()*6.28})}}
function hudSize(){const d=devicePixelRatio||1;cv.width=cv.clientWidth*d;cv.height=cv.clientHeight*d}
function hudState(){const r=$('reply').textContent;return talking?'speak':(r==='…'||r==='Cerco soluzioni…')?'think':on?'listen':'idle'}
function hudFrame(t){
  if(!hudOn)return;
  const st=hudState(),W=cv.width,H=cv.height,d=devicePixelRatio||1,R=Math.min(W,H)*0.34;
  const col=st==='listen'?'255,176,32':'63,208,255';
  const target=st==='speak'?0.55+0.45*Math.abs(Math.sin(t/110)*Math.sin(t/37)):st==='listen'?0.35:st==='think'?0.5:0.12;
  env+=(target-env)*0.15;ang+=st==='think'?0.02:0.004+env*0.01;
  cx.clearRect(0,0,W,H);
  const ca=Math.cos(ang),sa=Math.sin(ang);
  const P=pts.map(p=>{const x=p.x*ca+p.z*sa,z=-p.x*sa+p.z*ca,k=1/(1.8-z*0.5),q=1+env*0.12*Math.sin(t/180+p.p);return{x:W/2+x*R*k*q,y:H/2+p.y*R*k*q,a:0.25+0.5*(z+1)/2,p:p.p}});
  cx.lineWidth=d;const L=R*0.42;
  for(let i=0;i<P.length;i++)for(let j=i+1;j<P.length;j++){const q=Math.hypot(P[i].x-P[j].x,P[i].y-P[j].y);if(q<L){cx.strokeStyle='rgba('+col+','+((1-q/L)*0.35*(0.4+env)).toFixed(3)+')';cx.beginPath();cx.moveTo(P[i].x,P[i].y);cx.lineTo(P[j].x,P[j].y);cx.stroke()}}
  P.forEach(p=>{const g=0.5+0.5*Math.sin(t/400+p.p);cx.fillStyle='rgba('+col+','+Math.min(1,p.a+g*env).toFixed(2)+')';cx.beginPath();cx.arc(p.x,p.y,(1.5+g*1.5+env*2)*d,0,6.283);cx.fill()});
  for(let k=0;k<3;k++){const ph=(t/1800+k/3)%1;cx.strokeStyle='rgba('+col+','+((1-ph)*0.35*(0.3+env)).toFixed(3)+')';cx.beginPath();cx.arc(W/2,H/2,R*(0.5+ph*0.9)*(1+env*0.1),0,6.283);cx.stroke()}
  raf=requestAnimationFrame(hudFrame);
}
