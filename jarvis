function start(){
  if(!SR){speak('Questo browser non supporta il riconoscimento vocale. Usa Chrome o Safari aggiornato, oppure scrivi il comando.');return}
  const always=$('always').checked,r=new SR();rec=r;
  r.lang='it-IT';r.interimResults=true;r.continuous=always;
  r.onresult=e=>{
    let txt='',fin=false;
    for(let k=e.resultIndex;k<e.results.length;k++){txt+=e.results[k][0].transcript;if(e.results[k].isFinal)fin=true}
    txt=txt.trim();if(!txt)return;
    if(!fin){$('heard').textContent='Sento: '+txt;return}
    if(talking)return;
