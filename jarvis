  try{r.start();on=true;$('mic').classList.add('live');$('heard').textContent=always?'In ascolto: di’ “'+CFG.name+'…” e il comando':'Ti ascolto…'}catch(e){rec=null;$('heard').textContent='Non riesco ad avviare il microfono.'}
}
