$('sf').onsubmit=e=>{
  e.preventDefault();
  Object.assign(CFG,{name:$('s-name').value.trim()||'Jarvis',alias:$('s-alias').value.trim(),call:$('s-call').value.trim()||'Alessandro',style:$('s-style').value,extra:$('s-extra').value.trim(),voice:$('s-voice').value,rate:+$('s-rate').value,pitch:+$('s-pitch').value,model:$('s-model').value,theme:$('s-theme').value});
  try{localStorage.setItem('jarvis-cfg',JSON.stringify(CFG))}catch(x){}
  const k=$('key').value.trim();if(k){KEY=k;try{localStorage.setItem('jarvis-key',KEY)}catch(x){}}
  const ek=$('el-key').value.trim();if(ek)EL.key=ek;EL.vid=$('el-vid').value.trim();EL.on=$('el-on').checked;try{localStorage.setItem('jarvis-el',JSON.stringify(EL))}catch(x){}
  applyCfg();toneSel();$('sdlg').close();speak('Impostazioni salvate.');
};
applyCfg();
$('f').onsubmit=e=>{e.preventDefault();const v=$('txt').value.trim();if(v){run(v);$('txt').value=''}};
render();
</script>
</body>
</html>
